page {
  background: #F7F6F2;
  color: #2F3A3D;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button, scroll-view { box-sizing: border-box; }
button { font: inherit; }
button::after { border: 0; }
input, textarea { color: #2F3A3D; }
textarea { width: 100%; height: auto; }

.page { min-height: 100vh; padding: 36rpx 36rpx calc(56rpx + env(safe-area-inset-bottom)); }
.page-with-tab { padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }
.header { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; margin-bottom: 40rpx; }
.header-copy { flex: 1; min-width: 0; }
.eyebrow { display: block; color: #70838C; font-size: 24rpx; letter-spacing: 2rpx; margin-bottom: 8rpx; }
h1, .h1 { font-size: 46rpx; font-weight: 600; line-height: 1.3; letter-spacing: 1rpx; }
h2, .h2 { font-size: 34rpx; font-weight: 600; line-height: 1.45; }
.muted { color: #6F7A7D; }
.subtle { color: #7B8588; font-size: 25rpx; }
.body-small { font-size: 27rpx; }
.wrap { white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }
.row { display: flex; align-items: center; gap: 20rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.stack { display: flex; flex-direction: column; gap: 24rpx; }
.section { margin-top: 44rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.card { background: #FCFBF8; border: 1rpx solid #E5E5DF; border-radius: 24rpx; padding: 30rpx; }
.card + .card { margin-top: 20rpx; }
.divider { height: 1rpx; background: #E5E5DF; margin: 28rpx 0; }

.primary-btn, .secondary-btn, .quiet-btn, .danger-btn {
  min-height: 96rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center;
  padding: 20rpx 30rpx; font-size: 30rpx; line-height: 1.45; font-weight: 500;
}
.primary-btn { background: #7E97A6; color: #FFFFFF; }
.primary-btn.button-hover { background: #6D8796; }
.secondary-btn { background: #E8EEF0; color: #405E6C; }
.secondary-btn.button-hover { background: #DCE6E9; }
.quiet-btn { background: transparent; color: #526F7D; border: 1rpx solid #B9C8CE; }
.quiet-btn.button-hover { background: #EDF0EF; }
.danger-btn { background: transparent; color: #875F5A; border: 1rpx solid #CDB8B3; }
.button-disabled, button[disabled] { opacity: .48; }
.text-btn { min-height: 72rpx; min-width: 72rpx; padding: 14rpx 4rpx; color: #526F7D; background: transparent; font-size: 27rpx; }
.icon-text-btn { width: 88rpx; height: 88rpx; padding: 0; border-radius: 50%; background: #EDEFEB; color: #40565E; font-size: 25rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.full-btn { width: 100%; }
.button-row { display: flex; gap: 16rpx; }
.button-row > button { flex: 1; }

.field { margin-bottom: 30rpx; }
.field-label { display: block; font-size: 28rpx; font-weight: 500; margin-bottom: 12rpx; }
.field-hint { display: block; color: #788285; font-size: 24rpx; margin: -4rpx 0 12rpx; }
.input, .textarea { width: 100%; background: #FCFBF8; border: 1rpx solid #DDE1DE; border-radius: 18rpx; padding: 24rpx; font-size: 29rpx; line-height: 1.65; }
.input { min-height: 88rpx; }
.textarea { min-height: 176rpx; }
.input:focus, .textarea:focus { border-color: #7E97A6; }
.char-count { text-align: right; color: #899194; font-size: 23rpx; margin-top: 6rpx; }
.error-text { color: #875F5A; font-size: 26rpx; margin: -12rpx 0 22rpx; }
.tag { display: inline-flex; align-items: center; min-height: 48rpx; padding: 5rpx 16rpx; border-radius: 24rpx; background: #E8EEF0; color: #526873; font-size: 23rpx; line-height: 1.4; }
.tag-neutral { background: #EEEEE9; color: #667174; }
.tag-warm { background: #EFEAE3; color: #796C5E; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { min-width: 112rpx; min-height: 76rpx; padding: 16rpx 24rpx; border-radius: 18rpx; background: #FCFBF8; border: 1rpx solid #DDE1DE; color: #566367; font-size: 27rpx; }
.chip-selected { background: #E2EBEE; border-color: #8EA6B2; color: #365563; }
.progress-track { height: 8rpx; border-radius: 4rpx; background: #E3E6E3; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 4rpx; background: #7E97A6; }
.notice { padding: 22rpx 24rpx; background: #ECEFEA; color: #596763; border-radius: 18rpx; font-size: 26rpx; line-height: 1.65; }
.notice-warm { background: #F0ECE4; color: #746A5D; }
.empty-space { padding: 72rpx 30rpx; text-align: center; color: #748084; }
.empty-title { display: block; color: #435156; font-size: 31rpx; margin-bottom: 12rpx; }
.list-meta { color: #7A8588; font-size: 24rpx; }
.strikethrough { text-decoration: line-through; color: #929A9B; opacity: .72; }
.safe-bottom { height: env(safe-area-inset-bottom); }
