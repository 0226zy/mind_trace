<view wx:if="{{visible}}" class="sheet-mask" catchtouchmove="stopTouch">
  <view class="sheet" catchtap="stopTouch" role="dialog" aria-label="记录思虑">
    <block wx:if="{{stage === 'edit'}}">
      <view class="sheet-topbar">
        <text class="eyebrow">记录思虑</text>
        <button class="close-btn" bindtap="close" aria-label="关闭并保留草稿">×</button>
      </view>
      <scroll-view scroll-y class="writing-scroll" enhanced show-scrollbar="{{false}}">
        <view class="writing-heading">
          <view class="h1">此刻，脑海里反复出现的是什么？</view>
          <text class="writing-subtitle">先写下来，不用整理，也不用评判。</text>
        </view>
        <view wx:if="{{restored}}" class="restore-note">已恢复上次未提交的草稿</view>
        <textarea class="writing-input" auto-height focus="{{visible}}" adjust-position cursor-spacing="24" show-confirm-bar="{{false}}" maxlength="1000" value="{{form.loopThought}}" data-field="loopThought" bindinput="onInput" placeholder="把脑海里的原话写在这里……" placeholder-class="placeholder" aria-label="思虑正文" />
      </scroll-view>
      <view class="sheet-footer">
        <view wx:if="{{error}}" class="error-text" role="alert">{{error}}</view>
        <button class="primary-btn full-btn" disabled="{{!canSubmit}}" loading="{{submitting}}" bindtap="submit">写好了</button>
        <text class="local-hint">未提交内容会作为草稿留在本机</text>
      </view>
    </block>

    <view wx:elif="{{stage === 'matching' || stage === 'saving'}}" class="processing-state">
      <view class="processing-line"></view>
      <text class="empty-title">{{stage === 'matching' ? '正在安放这条思虑' : '正在保存'}}</text>
      <text>内容仍会保留，请稍等片刻。</text>
    </view>

    <block wx:elif="{{stage === 'match'}}">
      <view class="sheet-topbar"><text class="eyebrow">保存前确认</text></view>
      <view class="match-heading"><view class="h2">这可能是旧念复发</view><text>只会提示，不会自动合并。</text></view>
      <scroll-view scroll-y class="match-scroll" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{similarItems}}" wx:key="index" class="similar-item" data-index="{{index}}" bindtap="chooseSimilar" role="button">
          <view class="row-between"><text class="similar-title wrap">{{item.thought.title || '相似思虑'}}</text><text class="tag">关联为 v{{(item.thought.versionCount || 1) + 1}}</text></view>
          <text class="list-meta">已登记 {{item.thought.versionCount || 1}} 次 · 相似度 {{item.score <= 1 ? item.score * 100 : item.score}}%</text>
          <view class="similar-action">关联为新版本 →</view>
        </view>
        <view wx:if="{{matchError}}" class="notice match-notice">{{matchError}}</view>
        <view wx:if="{{error}}" class="error-text">{{error}}</view>
      </scroll-view>
      <view class="sheet-footer">
        <button class="primary-btn full-btn" bindtap="chooseNew">作为新思虑保存</button>
        <button class="text-btn full-btn" bindtap="resetFeedback">返回修改正文</button>
      </view>
    </block>

    <block wx:elif="{{stage === 'details'}}">
      <view class="sheet-topbar">
        <text class="eyebrow">正文已记录</text>
        <button class="close-btn" bindtap="close" aria-label="稍后补充并关闭">×</button>
      </view>
      <scroll-view scroll-y class="details-scroll" enhanced show-scrollbar="{{false}}">
        <view class="details-heading"><view class="h1">此刻，它让你有什么感受？</view><text>可以补充，也可以留到以后。</text></view>
        <view class="detail-section">
          <text class="detail-label">情绪</text>
          <view class="emotion-options">
            <button wx:for="{{emotionOptions}}" wx:key="name" class="emotion-option {{item.selected ? 'emotion-selected' : ''}}" data-emotion="{{item.name}}" bindtap="toggleEmotion" aria-pressed="{{item.selected}}">{{item.name}}</button>
          </view>
        </view>
        <view class="detail-section intensity-section">
          <view class="row-between"><text class="detail-label">强度</text><text class="intensity-current">{{form.intensity === null ? '未选择' : form.intensity + ' / 10'}}</text></view>
          <view class="intensity-options">
            <button wx:for="{{intensityOptions}}" wx:key="value" class="intensity-option {{item.value === form.intensity ? 'intensity-selected' : ''}}" data-value="{{item.value}}" bindtap="onIntensity" aria-pressed="{{item.value === form.intensity}}">{{item.label}}</button>
          </view>
          <text class="detail-hint">选择最接近此刻感受的一项</text>
        </view>
        <view wx:if="{{offlineSaved}}" class="notice">当前离线。若正文尚未开始同步，感受会随正文一并保存。</view>
        <view wx:if="{{error}}" class="error-text detail-error" role="alert">{{error}}</view>
      </scroll-view>
      <view class="sheet-footer">
        <button class="primary-btn full-btn" loading="{{submitting}}" bindtap="saveDetails">完成</button>
        <button class="text-btn full-btn" bindtap="later">暂不补充</button>
      </view>
    </block>

    <view wx:else class="complete-state">
      <text class="complete-mark" aria-hidden="true">✓</text>
      <view class="h1">这条思虑已安放好</view>
      <text class="complete-copy">不必现在想明白。需要时，再慢慢看清它。</text>
      <view class="complete-actions">
        <button wx:if="{{!offlineSaved}}" class="primary-btn full-btn" bindtap="evaluateNow">现在评估</button>
        <button class="secondary-btn full-btn" bindtap="later">回到此刻</button>
        <button class="text-btn full-btn" bindtap="emergency">我需要先叫停</button>
      </view>
    </view>
  </view>
</view>
