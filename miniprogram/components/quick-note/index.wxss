.sheet-mask { position: fixed; z-index: 1000; inset: 0; background: rgba(47,58,61,.28); display: flex; align-items: flex-end; }
.sheet { width: 100%; max-height: 91vh; background: #F7F6F2; border-radius: 32rpx 32rpx 0 0; padding: 18rpx 36rpx calc(28rpx + env(safe-area-inset-bottom)); }
.sheet-handle { width: 72rpx; height: 7rpx; background: #CDD3D0; border-radius: 4rpx; margin: 0 auto 24rpx; }
.sheet-heading { margin-bottom: 26rpx; }
.close-btn { width: 80rpx; height: 80rpx; padding: 0; border-radius: 50%; background: #E9ECE8; color: #5F6D71; font-size: 48rpx; line-height: 1; font-weight: 300; }
.form-scroll { max-height: 70vh; }
.label-light { color: #899194; font-size: 24rpx; font-weight: 400; }
.placeholder { color: #9AA2A3; }
.trigger-input { min-height: 120rpx; }
.thought-input { min-height: 168rpx; }
.emotion-chips { gap: 12rpx; }
.emotion-chips .chip { min-width: 0; }
.intensity-field { padding: 10rpx 0 0; }
.intensity-value { color: #526F7D; font-size: 38rpx; font-weight: 600; }
.intensity-total { color: #899194; font-size: 24rpx; font-weight: 400; }
.slider-labels { color: #899194; font-size: 22rpx; margin-top: -12rpx; }
.save-btn { margin-top: 8rpx; }
.local-hint { color: #899194; text-align: center; font-size: 22rpx; padding: 18rpx 12rpx 4rpx; }
.restore-note { margin-bottom: 22rpx; }
.processing-state { min-height: 460rpx; display: flex; flex-direction: column; justify-content: center; }
.calm-pulse { width: 64rpx; height: 64rpx; border-radius: 50%; background: #A9BAC2; margin: 0 auto 36rpx; animation: breathe 2s ease-in-out infinite; }
.match-scroll { max-height: 56vh; margin-bottom: 24rpx; }
.similar-card { margin-top: 24rpx; padding: 26rpx; border-radius: 20rpx; border: 1rpx solid #CBD7DB; background: #FCFBF8; }
.similar-title { font-size: 30rpx; font-weight: 600; max-width: 65%; }
.similar-action { margin-top: 18rpx; color: #526F7D; font-size: 26rpx; }
.match-notice { margin-top: 24rpx; }
.success-state { min-height: 580rpx; display: flex; flex-direction: column; justify-content: center; text-align: center; gap: 20rpx; padding: 24rpx 0; }
.success-mark { width: 88rpx; height: 88rpx; border-radius: 50%; background: #DFE8E7; color: #55736F; display: flex; align-items: center; justify-content: center; font-size: 48rpx; margin: 0 auto 10rpx; }
.success-copy { color: #657478; margin-bottom: 20rpx; }
.offline-notice { text-align: left; margin-bottom: 10rpx; }
.emergency-link { margin-top: -4rpx; }
@keyframes breathe { 0%,100% { transform: scale(.86); opacity: .55; } 50% { transform: scale(1.08); opacity: 1; } }
