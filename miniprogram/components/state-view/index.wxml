<view wx:if="{{loading}}" class="empty-space" role="status" aria-live="polite">
  <view class="loading-ring" aria-hidden="true"></view>
  <text>{{loadingText || '正在加载…'}}</text>
</view>
<view wx:elif="{{error}}" class="empty-space" role="alert">
  <text class="empty-title">暂时没有加载成功</text>
  <text class="wrap">{{error}}</text>
  <button class="quiet-btn retry-btn" bindtap="onRetry">重新加载</button>
</view>
<view wx:elif="{{empty}}" class="empty-space" role="status" aria-live="polite">
  <text class="empty-title">{{emptyTitle || '这里还很安静'}}</text>
  <text class="wrap">{{emptyText}}</text>
</view>
