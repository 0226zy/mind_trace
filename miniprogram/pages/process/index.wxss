.offline-panel { background: #ECEFEA; border-radius: 22rpx; padding: 24rpx; margin-bottom: 28rpx; }
.offline-title { font-weight: 600; font-size: 28rpx; }
.local-item { border-top: 1rpx solid #D8DEDA; padding: 22rpx 0 4rpx; margin-top: 20rpx; }
.local-item-title { font-size: 27rpx; max-width: 70%; }
.segmented { display: flex; padding: 6rpx; background: #E9EBE7; border-radius: 18rpx; margin-bottom: 30rpx; }
.segment { flex: 1; min-height: 76rpx; background: transparent; color: #6E7A7D; border-radius: 14rpx; font-size: 27rpx; }
.segment-active { background: #FCFBF8; color: #40565E; font-weight: 600; }
.record-list { padding-bottom: 30rpx; }
.record-card { margin-bottom: 20rpx; }
.record-trigger { font-size: 31rpx; font-weight: 600; margin-top: 22rpx; }
.record-thought { color: #69767A; font-size: 27rpx; margin-top: 12rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.record-footer { margin-top: 24rpx; }
.open-text { color: #526F7D; font-size: 25rpx; flex-shrink: 0; }
.record-card .progress-track { margin-top: 20rpx; }
