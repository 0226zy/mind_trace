<view class="page page-with-tab">
  <view class="header"><view class="h1">处理</view></view>

  <button wx:if="{{offlineItems.length}}" class="offline-summary" data-id="{{offlineItems[0].clientRequestId}}" bindtap="openLocal" aria-label="查看本机保存的记录">
    <text>{{offlineItems.length}} 条仅保存在本机</text><text class="summary-arrow">›</text>
  </button>

  <view class="segmented" role="tablist" aria-label="处理记录分段">
    <button class="segment {{tab === 'pending' ? 'segment-active' : ''}}" data-tab="pending" bindtap="changeTab" role="tab" aria-selected="{{tab === 'pending'}}">待处理</button>
    <button class="segment {{tab === 'closed' ? 'segment-active' : ''}}" data-tab="closed" bindtap="changeTab" role="tab" aria-selected="{{tab === 'closed'}}">已收尾</button>
  </view>

  <state-view loading="{{loading && !records.length}}" error="{{records.length ? '' : error}}" empty="{{!loading && !visibleRecords.length && (!error || records.length)}}" empty-title="{{tab === 'pending' ? '现在没有待处理的思虑' : '还没有已收尾的记录'}}" empty-text="{{tab === 'pending' ? '可以从思虑库查看已有记录。' : '完成七步评估后，记录会收在这里。'}}" bind:retry="load" />
  <navigator wx:if="{{tab === 'pending' && !loading && !visibleRecords.length && (!error || records.length)}}" class="empty-link" url="/pages/library/index" open-type="switchTab">去思虑库看看</navigator>
  <view wx:if="{{error && records.length}}" class="inline-error"><text>暂未刷新，可稍后重试</text><button class="text-btn" bindtap="load">重试</button></view>

  <view wx:if="{{records.length}}" class="record-list">
    <view class="record-item {{tab === 'pending' && index === 0 ? 'next-record' : ''}}" wx:for="{{visibleRecords}}" wx:key="id" data-id="{{item.id}}" bindtap="openRecord" role="button" aria-label="{{tab === 'pending' ? '继续处理' : '查看记录'}}：{{item.triggerEvent}}">
      <text wx:if="{{tab === 'pending' && index === 0}}" class="next-label">下一条</text>
      <view class="record-trigger wrap">{{item.triggerEvent}}</view>
      <view wx:if="{{item.loopThought && item.loopThought !== item.triggerEvent}}" class="record-thought wrap">{{item.loopThought}}</view>
      <text class="record-status">{{tab === 'pending' ? (item.step ? '第 ' + item.step + ' 步，共 7 步' : item.statusText) : item.statusText}}</text>
      <text class="open-text">{{tab === 'pending' ? '继续处理' : '查看记录'}}<text class="open-arrow">→</text></text>
    </view>
  </view>
</view>
