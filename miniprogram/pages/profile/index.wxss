.profile-page .header { margin-bottom: 24rpx; }
.profile-card { display: flex; align-items: center; gap: 24rpx; background: transparent; border-bottom: 1rpx solid var(--color-line); padding: 0 0 30rpx; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #E9ECE5; color: var(--color-accent); display: flex; align-items: center; justify-content: center; font-size: 34rpx; }
.profile-name { font-size: 31rpx; font-weight: 500; }
.menu-list { margin-top: 20rpx; }
.menu-item { width: 100%; min-height: 116rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); border-radius: 0; background: transparent; color: var(--color-accent); display: flex; align-items: center; justify-content: space-between; text-align: left; }
.menu-title { display: block; color: var(--color-text); font-size: 28rpx; font-weight: 500; }
.menu-desc { display: block; color: var(--color-muted); font-size: 24rpx; margin-top: 6rpx; }
.privacy-section, .danger-zone { margin-top: 48rpx; }
.privacy-section .section-title, .danger-zone .section-title { padding-bottom: 16rpx; border-bottom: 1rpx solid var(--color-line); }
.data-location { padding: 20rpx 0; }
.data-location .field-label { color: var(--color-muted); font-size: 24rpx; font-weight: 400; }
.privacy-copy { display: block; color: var(--color-muted); font-size: 25rpx; line-height: 1.75; margin-top: 18rpx; }
.delete-btn { margin-top: 30rpx; }
.delete-mask { position: fixed; inset: 0; z-index: 1000; background: rgba(32,37,34,.32); display: flex; align-items: flex-end; }
.delete-dialog { width: 100%; max-height: 90vh; overflow-y: auto; background: var(--color-bg); border-radius: 16rpx 16rpx 0 0; padding: 40rpx 32rpx calc(38rpx + env(safe-area-inset-bottom)); }
.delete-warning { display: block; color: #74645F; font-size: 26rpx; margin: 24rpx 0; }
.local-delete-check { padding: 18rpx 0; border-top: 1rpx solid var(--color-line); border-bottom: 1rpx solid var(--color-line); color: var(--color-muted); font-size: 24rpx; }
.local-delete-check .text-btn { min-height: 72rpx; }
.confirm-label { margin: 28rpx 0 16rpx; }
.delete-error { margin: 20rpx 0 0; }
.delete-actions { margin-top: 30rpx; }
