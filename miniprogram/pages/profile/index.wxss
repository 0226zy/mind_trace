.profile-card { display: flex; align-items: center; gap: 24rpx; background: transparent; border: 0; border-bottom: 1rpx solid #E1E4DE; border-radius: 0; padding: 0 0 30rpx; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #E6EDE7; color: #385C57; display: flex; align-items: center; justify-content: center; font-size: 34rpx; }
.profile-name { font-size: 32rpx; font-weight: 600; }
.menu-list { margin-top: 20rpx; }
.menu-item { width: 100%; min-height: 120rpx; padding: 24rpx 4rpx; border-bottom: 1rpx solid #E1E4DE; border-radius: 0; background: transparent; color: #69736E; display: flex; align-items: center; justify-content: space-between; text-align: left; }
.menu-title { display: block; color: #303834; font-size: 29rpx; font-weight: 500; }
.menu-desc { display: block; font-size: 24rpx; margin-top: 5rpx; }
.privacy-section, .danger-zone { margin-top: 48rpx; }
.privacy-section .section-title, .danger-zone .section-title { padding-bottom: 16rpx; border-bottom: 1rpx solid #E1E4DE; }
.privacy-note { margin-top: 16rpx; }
.delete-btn { margin-top: 30rpx; }
.delete-mask { position: fixed; inset: 0; z-index: 1000; background: rgba(32,37,34,.32); display: flex; align-items: flex-end; }
.delete-dialog { width: 100%; background: #F7F7F4; border-radius: 16rpx 16rpx 0 0; padding: 40rpx 40rpx calc(38rpx + env(safe-area-inset-bottom)); }
.delete-warning { display: block; color: #74645F; font-size: 27rpx; margin: 26rpx 0 32rpx; }
.confirm-label { margin-bottom: 16rpx; }
.delete-actions { margin-top: 30rpx; }
