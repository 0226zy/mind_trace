.local-title { margin: 16rpx 0 24rpx; font-size: 40rpx; line-height: 1.5; }
.local-status { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding-bottom: 26rpx; color: var(--color-muted); font-size: 24rpx; border-bottom: 1rpx solid var(--color-line); }
.local-field { margin-top: 30rpx; color: var(--color-text); font-size: 27rpx; line-height: 1.7; }
.local-field .field-label { color: var(--color-muted); font-size: 24rpx; font-weight: 400; }
.feeling-field { padding-bottom: 28rpx; border-bottom: 1rpx solid var(--color-line); }
.local-notice { margin: 26rpx 0; }
.local-action { margin: 32rpx 0 18rpx; }
.local-safety { display: block; color: var(--color-muted); text-align: center; font-size: 23rpx; margin-top: 24rpx; }
