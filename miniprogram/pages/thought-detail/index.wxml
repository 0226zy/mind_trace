<view class="page thought-detail-page">
  <state-view loading="{{loading && !thought}}" error="{{thought ? '' : error}}" bind:retry="load" />
  <view wx:if="{{error && thought}}" class="inline-error"><text>暂未刷新，已保留当前内容</text><button class="text-btn" bindtap="load">重试</button></view>
  <block wx:if="{{thought}}">
    <view class="h1 detail-title wrap">{{thought.title}}</view>
    <view class="detail-meta">{{thought.statusText}} · 共 {{thought.versionCount}} 个版本</view>
    <view wx:if="{{thought.versionCount >= 3}}" class="recurring-note">这个主题反复出现过，可以看看它们是否有共同之处。</view>

    <view class="section-title timeline-title">记录版本</view>
    <view class="timeline">
      <view class="version" wx:for="{{records}}" wx:key="id">
        <view class="timeline-rail"><view class="timeline-dot {{item.status === 'closed' ? 'dot-closed' : ''}}"></view><view wx:if="{{index < records.length - 1}}" class="timeline-line"></view></view>
        <view class="version-content">
          <view class="version-summary" data-index="{{index}}" bindtap="toggleVersion" role="button" aria-expanded="{{item.expanded}}" aria-label="{{item.expanded ? '收起' : '展开'}} {{item.createdAtText}} 的记录">
            <view><text class="version-number">第 {{item.versionNo || records.length - index}} 版</text><text class="version-time">{{item.createdAtText}}</text></view>
            <view class="row-between version-state"><text>{{item.statusText}}</text><text class="expand-icon" aria-hidden="true">{{item.expanded ? '−' : '+'}}</text></view>
          </view>
          <view wx:if="{{item.expanded}}" class="version-detail">
            <view class="detail-field thought-body"><text class="field-label">思虑正文</text><text class="wrap">{{item.loopThought}}</text></view>
            <view class="detail-field feeling-field"><text class="field-label">当下感受</text><text>{{item.emotionsText || '情绪未补充'}} · {{item.intensity > 0 ? '强度 ' + item.intensity + '/10' : '强度未补充'}}</text></view>
            <view wx:if="{{item.inheritedFrom}}" class="inherit-line">这一版继承了上一版的评估内容，并按本次情况重新处理。</view>
            <block wx:if="{{item.status !== 'registered'}}">
              <view class="detail-field"><text class="field-label">判断</text><text>{{item.ruminationType || '未填写'}}</text></view>
              <view class="detail-field"><text class="field-label">风险内容 · 概率 {{item.probability === undefined || item.probability === null ? '—' : item.probability + '%'}}</text><text class="wrap">{{item.riskContent || '未填写'}}</text></view>
              <view class="detail-field" wx:if="{{item.actions.length}}"><text class="field-label">可控行动</text><view wx:for="{{item.actions}}" wx:for-item="action" wx:key="index" class="detail-list-item {{action.done ? 'strikethrough' : ''}}">{{action.done ? '✓' : '○'}} {{action.text}}</view></view>
              <view class="detail-field" wx:if="{{item.uncontrollables.length}}"><text class="field-label">不可控内容</text><view wx:for="{{item.uncontrollables}}" wx:for-item="entry" wx:key="index" class="detail-list-item {{entry.crossedOut ? 'strikethrough' : ''}}">{{entry.crossedOut ? '✓' : '○'}} {{entry.text}}</view></view>
              <view class="detail-field" wx:if="{{item.scenarioWorst || item.scenarioLikely || item.scenarioBest}}"><text class="field-label">三种视角</text><view class="perspective"><text>最坏</text><view class="wrap">{{item.scenarioWorst}}</view></view><view class="perspective"><text>最可能</text><view class="wrap">{{item.scenarioLikely}}</view></view><view class="perspective"><text>最好</text><view class="wrap">{{item.scenarioBest}}</view></view></view>
            </block>
            <button class="secondary-btn full-btn version-action" data-id="{{item.id}}" bindtap="openEvaluation">{{item.status === 'closed' ? '查看完整处理结果' : item.status === 'registered' ? '开始评估' : '继续这次评估'}}</button>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{!records.length}}" class="empty-space"><text class="empty-title">还没有登记版本</text></view>
  </block>
</view>
