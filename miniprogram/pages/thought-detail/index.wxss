.thought-detail-page { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.detail-title { font-size: 40rpx; line-height: 1.5; margin: 20rpx 0 16rpx; }
.detail-meta { color: var(--color-muted); font-size: 24rpx; }
.recurring-note { color: var(--color-muted); font-size: 24rpx; line-height: 1.65; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--color-line); }
.timeline-title { margin-top: 48rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--color-line); }
.timeline { padding-bottom: 30rpx; }
.version { display: flex; align-items: stretch; }
.timeline-rail { width: 32rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; padding-top: 38rpx; }
.timeline-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--color-accent); flex-shrink: 0; }
.dot-closed { background: #929D96; }
.timeline-line { width: 1rpx; background: var(--color-line); flex: 1; margin-top: 12rpx; }
.version-content { flex: 1; min-width: 0; }
.version-summary { min-height: 112rpx; padding: 24rpx 0 20rpx; border-bottom: 1rpx solid var(--color-line); }
.version-number { color: var(--color-text); font-size: 27rpx; font-weight: 500; }
.version-time { color: var(--color-muted); font-size: 23rpx; margin-left: 20rpx; }
.version-state { color: var(--color-muted); font-size: 23rpx; margin-top: 8rpx; }
.expand-icon { width: 56rpx; color: var(--color-accent); font-size: 32rpx; text-align: right; }
.version-detail { border-bottom: 1rpx solid var(--color-line); padding: 4rpx 0 30rpx; }
.detail-field { margin-top: 28rpx; color: #3D4741; font-size: 27rpx; line-height: 1.7; }
.detail-field .field-label { color: var(--color-muted); font-size: 24rpx; font-weight: 400; }
.thought-body { padding-top: 4rpx; }
.feeling-field { padding-bottom: 26rpx; border-bottom: 1rpx solid var(--color-line); }
.inherit-line { margin-top: 26rpx; color: #5D6B62; font-size: 24rpx; background: #EEF1EB; padding: 18rpx 20rpx; border-radius: var(--radius-m); }
.detail-list-item { padding: 10rpx 0; overflow-wrap: anywhere; }
.perspective { margin-top: 18rpx; }
.perspective > text { color: var(--color-muted); font-size: 23rpx; }
.version-action { margin-top: 32rpx; }
