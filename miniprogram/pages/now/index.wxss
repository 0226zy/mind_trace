.now-page { padding-top: calc(24rpx + env(safe-area-inset-top)); display: flex; flex-direction: column; }
.now-header { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; }
.brand { color: var(--color-text); font-size: 32rpx; font-weight: 600; letter-spacing: 4rpx; }
.now-hero { padding: 96rpx 0 52rpx; }
.now-hero .h1 { max-width: 620rpx; font-size: 42rpx; line-height: 1.5; }
.now-note { display: block; color: var(--color-muted); font-size: 28rpx; margin-top: 18rpx; }
.capture-btn { min-height: 96rpx; margin-top: 56rpx; font-size: 30rpx; }
.privacy-note { display: block; color: var(--color-muted); text-align: center; font-size: 23rpx; margin-top: 18rpx; }
.now-summary { min-height: 96rpx; }
.summary-line { width: 100%; min-height: 88rpx; padding: 16rpx 0; display: flex; align-items: center; justify-content: space-between; background: transparent; border-top: 1rpx solid var(--color-line); border-bottom: 1rpx solid var(--color-line); border-radius: 0; color: var(--color-muted); text-align: left; font-size: 25rpx; }
.summary-arrow { color: var(--color-accent); font-size: 36rpx; line-height: 1; }
.first-use-note { display: block; color: var(--color-muted); font-size: 25rpx; padding: 22rpx 0; border-top: 1rpx solid var(--color-line); }
.summary-error { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: var(--color-muted); font-size: 23rpx; border-top: 1rpx solid var(--color-line); }
.summary-error .text-btn { min-height: 72rpx; flex-shrink: 0; }
.emergency-entry { width: 100%; min-height: 88rpx; margin-top: auto; padding: 20rpx 0; display: flex; align-items: center; justify-content: space-between; background: transparent; border-top: 1rpx solid var(--color-line); border-radius: 0; color: var(--color-muted); text-align: left; font-size: 25rpx; }
.emergency-entry.button-hover, .summary-line.button-hover { background: #EFF1EB; }
