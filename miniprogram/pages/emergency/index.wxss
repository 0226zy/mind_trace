.emergency-page { padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.tool-home { padding-top: 32rpx; }
.tool-intro { display: block; margin-top: 20rpx; color: #656D63; font-size: 28rpx; line-height: 1.65; }
.tool-list { margin-top: 56rpx; border-top: 1px solid #E3E3DD; }
.tool-choice { width: 100%; min-height: 104rpx; padding: 24rpx 0; border-bottom: 1px solid #E3E3DD; border-radius: 0; background: transparent; color: #242824; display: flex; align-items: center; justify-content: space-between; text-align: left; font-size: 30rpx; font-weight: 500; line-height: 1.5; }
.tool-choice.button-hover { background: #E9ECE5; }
.tool-arrow { color: #385C57; font-weight: 400; padding-left: 24rpx; }
.tool-header { min-height: 88rpx; margin-bottom: 32rpx; border-bottom: 1px solid #E3E3DD; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.tool-back { min-width: 176rpx; min-height: 88rpx; margin: 0; padding: 16rpx 16rpx 16rpx 0; background: transparent; color: #385C57; font-size: 26rpx; text-align: left; }
.tool-name { color: #656D63; font-size: 24rpx; text-align: right; }
.step-meta { display: block; color: #656D63; font-size: 24rpx; line-height: 1.5; }
.sense-title { margin: 16rpx 0; font-size: 40rpx; }
.guidance-text { display: block; color: #656D63; font-size: 27rpx; line-height: 1.65; margin-bottom: 32rpx; }
.sense-input { display: flex; align-items: center; gap: 20rpx; min-height: 96rpx; border-bottom: 1px solid #E3E3DD; }
.sense-index { width: 36rpx; flex-shrink: 0; color: #385C57; font-size: 25rpx; font-variant-numeric: tabular-nums; }
.sense-input input { flex: 1; min-width: 0; height: 94rpx; font-size: 28rpx; }
.placeholder { color: #656D63; }
.sense-error { margin: 24rpx 0 0; }
.sense-actions { margin-top: 40rpx; }
.complete-panel { padding: 112rpx 0 64rpx; text-align: center; }
.complete-return { margin-top: 56rpx; }
.phrase-panel { padding-top: 32rpx; text-align: center; }
.phrase { margin: 64rpx 0 32rpx; color: #242824; font-size: 60rpx; font-weight: 500; line-height: 1.6; }
.phrase-note, .timer-note { display: block; color: #656D63; font-size: 27rpx; line-height: 1.7; }
.phrase-note { margin-bottom: 48rpx; }
.timer-panel { padding-top: 48rpx; text-align: center; }
.timer-note { text-align: left; }
.timer-clock { padding: 64rpx 0 56rpx; color: #385C57; font-size: 112rpx; font-weight: 400; line-height: 1.2; font-variant-numeric: tabular-nums; letter-spacing: 4rpx; }
.timer-btn { margin-bottom: 8rpx; }
.emergency-exit { width: 100%; min-height: 88rpx; margin-top: 24rpx; padding: 16rpx; background: transparent; color: #656D63; font-size: 26rpx; }
.emergency-exit.button-hover, .tool-back.button-hover { opacity: .65; }
