.emergency-page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.tool-tabs { display: flex; border-bottom: 1rpx solid #DDE2DB; margin-bottom: 42rpx; }
.tool-tab { flex: 1; min-width: 0; min-height: 84rpx; border-radius: 0; border-bottom: 4rpx solid transparent; background: transparent; color: #737D76; font-size: 24rpx; padding: 10rpx 6rpx; }
.tool-active { color: #294A45; border-bottom-color: #385C57; font-weight: 600; }
.sense-panel { padding-top: 16rpx; }
.sense-title { margin: 14rpx 0; font-size: 40rpx; line-height: 1.45; }
.guidance-text { display: block; color: #737D76; font-size: 26rpx; margin-bottom: 36rpx; }
.sense-input { display: flex; align-items: center; gap: 20rpx; min-height: 96rpx; background: #FDFDFB; border: 1rpx solid #D8DED7; border-radius: 12rpx; padding: 0 24rpx; margin-bottom: 18rpx; }
.sense-index { color: #385C57; font-size: 26rpx; }
.sense-input input { flex: 1; height: 94rpx; font-size: 28rpx; }
.placeholder { color: #929A94; }
.sense-error { margin-top: 24rpx; }
.sense-actions { margin-top: 34rpx; }
.sense-complete, .phrase-panel, .timer-panel { min-height: 650rpx; display: flex; flex-direction: column; justify-content: center; text-align: center; }
.complete-symbol { color: #385C57; margin: 0 auto 30rpx; font-size: 52rpx; }
.sense-complete .muted { margin-top: 20rpx; }
.complete-actions { margin-top: 60rpx; }
.phrase { font-size: 58rpx; font-weight: 500; line-height: 1.65; color: #303834; margin: 54rpx 0 34rpx; }
.phrase-note, .timer-note { color: #737D76; font-size: 26rpx; line-height: 1.75; margin-bottom: 54rpx; }
.timer-title { margin: 16rpx 0 20rpx; }
.timer-clock { font-size: 104rpx; font-weight: 400; color: #385C57; font-variant-numeric: tabular-nums; letter-spacing: 4rpx; padding: 40rpx 0; }
.timer-running { animation: quietPulse 3s ease-in-out infinite; }
.timer-complete { margin-bottom: 28rpx; text-align: left; }
.timer-btn { margin-bottom: 12rpx; }
@keyframes quietPulse { 0%,100% { opacity: .72; } 50% { opacity: 1; } }
