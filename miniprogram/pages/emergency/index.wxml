<view class="page emergency-page">
  <view wx:if="{{!tool}}" class="tool-home">
    <view class="h1">应急叫停</view>
    <text class="tool-intro">适合暂时停一下、把注意力带回身体的时刻。</text>
    <view class="tool-list">
      <button class="tool-choice" data-tool="senses" bindtap="switchTool"><text>5-4-3 感官落地</text><text class="tool-arrow" aria-hidden="true">→</text></button>
      <button class="tool-choice" data-tool="phrase" bindtap="switchTool"><text>一句打断</text><text class="tool-arrow" aria-hidden="true">→</text></button>
      <button class="tool-choice" data-tool="timer" bindtap="switchTool"><text>5 分钟抽离</text><text class="tool-arrow" aria-hidden="true">→</text></button>
    </view>
  </view>

  <block wx:else>
    <view class="tool-header">
      <button class="tool-back" data-tool="" bindtap="switchTool">← 三个工具</button>
      <text class="tool-name">{{tool === 'senses' ? '5-4-3 感官落地' : tool === 'phrase' ? '一句打断' : '5 分钟抽离'}}</text>
    </view>

    <block wx:if="{{tool === 'senses'}}">
      <view wx:if="{{!sensesDone}}" class="sense-panel">
        <text class="step-meta">第 {{senseStep + 1}} 步，共 3 步</text>
        <view class="h2 sense-title">{{sensePrompts[senseStep].title}}</view>
        <text class="guidance-text">{{sensePrompts[senseStep].hint}}</text>
        <view class="sense-input" wx:for="{{sensePrompts[senseStep].count}}" wx:key="index">
          <text class="sense-index">{{index + 1}}</text>
          <input value="{{senseValues[senseStep][index]}}" data-index="{{index}}" bindinput="onSenseInput" placeholder="{{sensePrompts[senseStep].placeholders[index]}}" placeholder-class="placeholder" aria-label="{{sensePrompts[senseStep].title}}，第 {{index + 1}} 项" />
        </view>
        <view wx:if="{{senseError}}" class="error-text sense-error" role="alert">{{senseError}}</view>
        <view class="button-row sense-actions"><button wx:if="{{senseStep > 0}}" class="quiet-btn" bindtap="previousSense">上一步</button><button class="primary-btn" bindtap="nextSense">{{senseStep === 2 ? '完成' : '下一步'}}</button></view>
      </view>
      <view wx:else class="complete-panel"><view class="h2">可以停在这里</view><button class="primary-btn full-btn complete-return" bindtap="done">返回</button></view>
    </block>

    <block wx:elif="{{tool === 'phrase'}}">
      <view wx:if="{{!phraseRepeated}}" class="phrase-panel">
        <text class="step-meta">轻轻对自己复述</text>
        <view class="phrase"><view>这是想法，</view><view>不是事实。</view></view>
        <text class="phrase-note">想法可以被看见，不必立刻被相信或解决。</text>
        <button class="primary-btn full-btn" bindtap="repeatPhrase">我已复述一遍</button>
      </view>
      <view wx:else class="complete-panel"><view class="h2">可以停在这里</view><button class="primary-btn full-btn complete-return" bindtap="done">返回</button></view>
    </block>

    <block wx:else>
      <view wx:if="{{timerDone}}" class="complete-panel"><view class="h2">可以停在这里</view><button class="primary-btn full-btn complete-return" bindtap="done">返回</button></view>
      <view wx:else class="timer-panel">
        <text class="timer-note">走几步、倒一杯水，或看看窗外。离开页面后，计时会按结束时间继续。</text>
        <view class="timer-clock" role="status" aria-live="polite">{{timeText}}</view>
        <button wx:if="{{!timerRunning}}" class="primary-btn full-btn timer-btn" bindtap="startTimer">{{remaining < 300 && remaining > 0 ? '继续计时' : '开始 5 分钟'}}</button>
        <button wx:else class="secondary-btn full-btn timer-btn" bindtap="pauseTimer">暂停</button>
        <button class="text-btn full-btn" bindtap="resetTimer">重置计时</button>
      </view>
    </block>

    <button wx:if="{{(tool === 'senses' && !sensesDone) || (tool === 'phrase' && !phraseRepeated) || (tool === 'timer' && !timerDone)}}" class="emergency-exit" bindtap="done">退出</button>
  </block>
</view>
