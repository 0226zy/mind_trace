<view class="page page-with-tab library-page">
  <view class="header"><view class="header-copy"><view class="h1">思虑库</view></view><button class="icon-text-btn stats-btn" bindtap="goStats">统计</button></view>
  <view class="search-row">
    <view class="search-box"><text class="search-symbol" aria-hidden="true">⌕</text><input value="{{query}}" bindinput="onQuery" bindconfirm="search" confirm-type="search" placeholder="搜索写下的内容" placeholder-class="placeholder" aria-label="搜索思虑" /><button wx:if="{{query}}" class="clear-search" bindtap="clearSearch" aria-label="清空搜索">×</button></view>
    <button class="filter-btn {{filtersVisible ? 'filter-active' : ''}}" bindtap="toggleFilters" aria-expanded="{{filtersVisible}}">筛选</button>
  </view>
  <view wx:if="{{query || status || emotion || timeRange || frequentOnly}}" class="active-filters">
    <text>已应用筛选{{emotion ? ' · ' + emotion : ''}}{{frequentOnly ? ' · 高频' : ''}}</text>
    <button class="text-btn" bindtap="resetFilters">清除</button>
  </view>
  <view wx:if="{{filtersVisible}}" class="filters">
    <text class="field-label">状态</text><view class="chips filter-chips"><button wx:for="{{statuses}}" wx:key="value" class="chip {{status === item.value ? 'chip-selected' : ''}}" data-value="{{item.value}}" bindtap="setStatus" aria-pressed="{{status === item.value}}">{{item.label}}</button></view>
    <text class="field-label filter-label">情绪</text><view class="chips filter-chips"><button wx:for="{{emotions}}" wx:key="*this" class="chip {{emotion === item ? 'chip-selected' : ''}}" data-value="{{item}}" bindtap="setEmotion" aria-pressed="{{emotion === item}}">{{item}}</button></view>
    <text class="field-label filter-label">最近登记</text><view class="chips filter-chips"><button wx:for="{{times}}" wx:key="value" class="chip {{timeRange === item.value ? 'chip-selected' : ''}}" data-value="{{item.value}}" bindtap="setTime" aria-pressed="{{timeRange === item.value}}">{{item.label}}</button></view>
    <button class="frequency-filter {{frequentOnly ? 'frequency-active' : ''}}" bindtap="toggleFrequent" aria-pressed="{{frequentOnly}}"><text>{{frequentOnly ? '✓' : '○'}}</text> 只看高频思绪（3 次及以上）</button>
    <button class="text-btn reset-btn" bindtap="resetFilters">清空全部筛选</button>
  </view>
  <view class="row-between result-meta"><text class="list-meta">{{timeRange || frequentOnly ? '已加载内容中显示 ' + visibleItems.length + ' 个' : '共 ' + total + ' 个思虑点'}}</text><text class="list-meta">按最近登记排序</text></view>
  <state-view loading="{{loading && !items.length}}" error="{{items.length ? '' : error}}" empty="{{!loading && !visibleItems.length && (!error || items.length)}}" empty-title="没有找到相符的思虑" empty-text="可以换个关键词或清空筛选。" bind:retry="load" />
  <view wx:if="{{error && items.length}}" class="inline-error"><text>暂未刷新，已保留当前列表</text><button class="text-btn" bindtap="search">重试</button></view>
  <view wx:if="{{items.length}}" class="thought-list">
    <view class="thought-item" wx:for="{{visibleItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openThought" role="button" aria-label="查看思虑：{{item.title}}">
      <view class="thought-title wrap">{{item.title}}</view>
      <view wx:if="{{item.excerpt && item.excerpt !== item.title}}" class="thought-excerpt wrap">{{item.excerpt}}</view>
      <view class="thought-meta"><text>{{item.lastRecordAtText}}</text><text>{{item.statusText}}{{item.versionCount >= 3 ? ' · 登记 ' + item.versionCount + ' 次' : ''}}</text></view>
    </view>
    <button wx:if="{{items.length < total}}" class="quiet-btn full-btn load-more" bindtap="loadMore" disabled="{{loadingMore}}">{{loadingMore ? '正在加载…' : '加载更多'}}</button>
    <view wx:if="{{loadingMore}}" class="list-meta loading-more">正在加载更多…</view>
  </view>
</view>
