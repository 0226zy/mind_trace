# Copy to .env for local development; never commit real credentials.
APP_ENV=development
PORT=8080
MYSQL_DSN=mindtrace:change-me@tcp(127.0.0.1:3306)/mind_trace?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_TTL_HOURS=168
AUTH_DEV_MODE=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_URL=https://api.weixin.qq.com/sns/jscode2session
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ALLOWED_ORIGINS=http://localhost:5173
